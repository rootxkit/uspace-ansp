# Build and test output
/bin/
/dist/
*.test
*.out
coverage.*
bench.txt
integration.log

# Fuzz corpora that go test writes for failing inputs are kept under
# <pkg>/testdata/fuzz/ and ARE committed (they are regression tests).

# Local data that must never be committed (CLAUDE.md rule 11): the
# development passwords and NATS keys (scripts/nats-creds.sh), geoid
# grids, DEM tiles, keys, environment files.
/local/
*.pgm
*.tif
*.tiff
*.pem
*.key
*.nk
*.creds
.env
.env.*
!.env.example

# web/ (WP-11)
node_modules/
/web/.next/
/web/out/
*.tsbuildinfo
/web/next-env.d.ts

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Tooling caches
/.golangci-cache/
/.staticcheck/
