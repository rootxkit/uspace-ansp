# Every text file is committed and checked out with LF line endings,
# whatever the platform. Go, YAML, JSON and shell scripts all break or
# churn under CRLF (a shell script with CRLF does not run on ubuntu CI).
* text=auto eol=lf

*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
go.mod text eol=lf
go.sum text eol=lf
.env.example text eol=lf

# Binary fixtures (none committed: geoid grids and DEM tiles never are).
*.pgm binary
*.png binary
*.woff2 binary

# dump1090 SBS samples keep the writer's CRLF line endings (WP-4).
internal/manned/dump1090/testdata/*.txt -text
