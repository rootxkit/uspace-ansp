# Every ANSP_* variable with its default (internal/config; a test keeps
# this file and the catalogue in step). Empty means unset. No real value,
# host name, password or key is ever written here (CLAUDE.md rule 11):
# domains live in the private infra repo, secrets in files (*_FILE).
# An ANSP_* variable that is not listed here is refused at start.

# api, manned-adapter or manned-feed; set by the entrypoint.
ANSP_PROCESS=
# Tells processes of one kind apart (an adapter's id, for example).
ANSP_INSTANCE=local
# A label for logs and the envelope producer; never a JWT audience.
ANSP_SYSTEM_ID=ansp
# Hosts accepted as aud: the public host plus a lab alias (M18).
ANSP_AUDIENCES=
ANSP_HTTP_ADDR=:8080

# NATS; the credentials file is a user JWT .creds or an NKey seed.
ANSP_NATS_URL=
ANSP_NATS_CREDS=

# The two databases (two trees, never one database).
ANSP_RELATIONAL_DSN=
ANSP_TIMESERIES_DSN=
# Per database and process: pool size, the wait for a connection, the
# bound of a statement (and of a lock wait), of a transaction.
ANSP_DB_MAX_CONNS=10
ANSP_DB_ACQUIRE_TIMEOUT_S=5
ANSP_DB_STATEMENT_TIMEOUT_S=5
ANSP_DB_TX_TIMEOUT_S=15

# iss=jwks_url pairs, comma-separated: the authority and the lab issuer.
ANSP_TOKEN_ISSUERS=
ANSP_TOKEN_URL=
ANSP_CLIENT_ID=ansp-01
ANSP_CLIENT_SECRET_FILE=

ANSP_CISP_URL=
# iss=jwks_url pairs accepted on /v1/cis/notifications (the CISP).
ANSP_CIS_NOTIFY_ISSUERS=
# publisher=jwks_url pairs (authority, ansp): a CIS dataset version is
# used only when its publisher's signature verifies; otherwise it is held.
ANSP_CIS_PUBLISHER_KEYS=
# How old a publisher signature's iat may be (366 days).
ANSP_CIS_PUBLISHER_SIG_MAX_AGE_S=31622400
# Its host is the DSS audience.
ANSP_DSS_URL=
ANSP_AUTHORITY_URL=
# uss_base_url, callback_url base and the host of this system's aud.
ANSP_PUBLIC_BASE_URL=

# required or off; off is logged at error level every status period.
ANSP_MTLS_MODE=required
# A JSON file [{"sub": "<client id>", "subject": "<certificate subject>"}]
# binding each client to its certificate on the mTLS routes (M25).
# Required with ANSP_MTLS_MODE=required: api refuses to start without it.
ANSP_MTLS_BINDINGS_FILE=
# Reverse proxies (comma-separated CIDRs or addresses) whose
# X-Forwarded-For and X-Client-Cert-Subject are believed; empty trusts no
# proxy, so with ANSP_MTLS_MODE=required every mTLS route is refused.
# An entry that is neither a CIDR nor an address refuses the start.
ANSP_TRUSTED_PROXIES=
# Origins a browser WebSocket upgrade may come from (scheme://host[:port]).
ANSP_WS_ALLOWED_ORIGINS=
# PEM RSA key (>= 2048 bits) that signs console sessions.
ANSP_SESSION_KEY_FILE=
# 32 random bytes (base64 or hex) sealing TOTP secrets at rest.
ANSP_SECRETS_KEY_FILE=
# Sign-in limits (S-15): per address and per username per minute, and
# the lockout of a username after failures, for seconds.
ANSP_LOGIN_IP_PER_MIN=10
ANSP_LOGIN_USER_PER_MIN=5
ANSP_LOGIN_LOCKOUT_AFTER=10
ANSP_LOGIN_LOCKOUT_S=900
# The first admin, created at start when there is no account yet.
ANSP_BOOTSTRAP_ADMIN_USERNAME=
ANSP_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# manned-adapter (WP-4): replay, dump1090_sbs, dump1090_json or
# asterix_cat021 (a stub that refuses to start); the instance id
# (lower-case, the <adapter> of man.v1.<adapter>.<icao24>); ads_b,
# mode_s, ssr, atm_feed or ads_l.
ANSP_ADAPTER_KIND=
ANSP_ADAPTER_ID=
ANSP_ADAPTER_SOURCE_CLASS=
# dump1090_sbs: the BaseStation output host:port, and the zone dump1090
# writes its time columns in (the receiver's local time).
ANSP_ADAPTER_SBS_ADDR=
ANSP_ADAPTER_SBS_TIMEZONE=UTC
# dump1090_json: the URL of aircraft.json.
ANSP_ADAPTER_JSON_URL=
# replay: a synthetic NDJSON file; replay never runs unless allowed.
ANSP_ADAPTER_REPLAY_FILE=
ANSP_ADAPTER_REPLAY_ALLOWED=false
ANSP_ADAPTER_REPLAY_SPEED=1
ANSP_ADAPTER_REPLAY_LOOP=false
# debug, info, warn or error.
ANSP_LOG_LEVEL=info
# OTLP HTTP endpoint; empty disables tracing.
ANSP_OTLP_ENDPOINT=
# ISO 3166-1 alpha-3.
ANSP_COUNTRY=GEO
# api (WP-5): the GeographicLib geoid grid (.pgm) for the F3548 volumes of
# AMSL restrictions; without it an AMSL restriction is refused (503
# geoid_unavailable). The zone authority of every restriction feature.
ANSP_GEOID_FILE=
ANSP_AUTHORITY_NAME=ANSP
ANSP_AUTHORITY_SERVICE=
ANSP_AUTHORITY_EMAIL=
ANSP_AUTHORITY_PHONE=
